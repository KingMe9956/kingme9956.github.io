#!/bin/bash ################################################################################ # KYIAM.xyz - Human-First-Forever Protocol # Automated Deployment Script with Security Gates ################################################################################ # # Copyright © 2026 KYIAM # KYIAM.COM # KYIAM.UNIVER.SE # # EXPLICITLY ALL RIGHTS RESERVED # KYIAM.XYZ AI-to-AI © 2026 # # This script deploys KYIAM to staging or production with full security checks. # # Usage: ./deploy.sh [staging|production] ################################################################################ set -euo pipefail # Exit on error, undefined vars, pipe failures # ============================================================================== # Configuration # ============================================================================== ENVIRONMENT="${1:-staging}" SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)" PROJECT_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)" RED='\033[0;31m' GREEN='\033[0;32m' YELLOW='\033[1;33m' BLUE='\033[0;34m' NC='\033[0m' # No Color # ============================================================================== # Helper Functions # ============================================================================== log_info() { echo -e "${BLUE}ℹ${NC} $1" } log_success() { echo -e "${GREEN}✅${NC} $1" } log_warning() { echo -e "${YELLOW}⚠️${NC} $1" } log_error() { echo -e "${RED}❌${NC} $1" } log_section() { echo "" echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}" echo -e "${BLUE}$1${NC}" echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}" echo "" } confirm_action() { local message="$1" echo -en "${YELLOW}$message (y/N): ${NC}" read -r response if [[ ! "$response" =~ ^[Yy]$ ]]; then log_error "Deployment cancelled by user" exit 1 fi } # ============================================================================== # Validation # ============================================================================== validate_environment() { log_section "Validating Environment" if [[ "$ENVIRONMENT" != "staging" && "$ENVIRONMENT" != "production" ]]; then log_error "Invalid environment: $ENVIRONMENT" log_info "Usage: ./deploy.sh [staging|production]" exit 1 fi log_success "Environment: $ENVIRONMENT" } # ============================================================================== # Pre-Deployment Security Gates # ============================================================================== run_security_gates() { log_section "Running Pre-Deployment Security Gates" # Gate 1: Copyright verification log_info "Gate 1: Verifying copyright headers..." if ! grep -q "KYIAM.XYZ AI-to-AI © 2026" "$PROJECT_ROOT/LICENSE"; then log_error "LICENSE file missing copyright notice" exit 1 fi log_success "Copyright verification passed" # Gate 2: No uncommitted changes log_info "Gate 2: Checking for uncommitted changes..." cd "$PROJECT_ROOT" if [[ -n $(git status --porcelain) ]]; then log_error "Uncommitted changes detected" log_info "Commit or stash changes before deploying" exit 1 fi log_success "No uncommitted changes" # Gate 3: On correct branch log_info "Gate 3: Verifying git branch..." CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD) if [[ "$ENVIRONMENT" == "production" && "$CURRENT_BRANCH" != "main"
log_info "Current branch: $CURRENT_BRANCH"
    exit 1
  fi
  
  if [[ "$ENVIRONMENT" == "staging" && "$CURRENT_BRANCH" != "develop" ]]; then
    log_warning "Staging deploys typically from 'develop' branch"
    log_info "Current branch: $CURRENT_BRANCH"
    confirm_action "Continue anyway?"
  fi
  
  log_success "Branch verification passed"
  
  # Gate 4: Dependencies up to date
  log_info "Gate 4: Checking dependencies..."
  if ! npm ci > /dev/null 2>&1; then
    log_error "Failed to install dependencies"
    exit 1
  fi
  log_success "Dependencies installed"
  
  # Gate 5: Security vulnerabilities
  log_info "Gate 5: Scanning for vulnerabilities..."
  if ! npm audit --audit-level=high > /dev/null 2>&1; then
    log_error "High/critical vulnerabilities detected"
    npm audit
    exit 1
  fi
  log_success "No high/critical vulnerabilities"
  
  # Gate 6: Tests pass
  log_info "Gate 6: Running test suite..."
  if ! npm test > /dev/null 2>&1; then
    log_error "Tests failed"
    npm test
    exit 1
  fi
  log_success "All tests passed"
  
  # Gate 7: Build succeeds
  log_info "Gate 7: Building application..."
  if ! npm run build > /dev/null 2>&1; then
    log_error "Build failed"
    npm run build
    exit 1
  fi
  log_success "Build successful"
  
  # Gate 8: Security audit checklist
  log_info "Gate 8: Running security audit checklist..."
  if [ -f "$SCRIPT_DIR/security-audit.sh" ]; then
    if ! bash "$SCRIPT_DIR/security-audit.sh"; then
      log_error "Security audit failed"
      exit 1
    fi
  fi
  log_success "Security audit passed"
  
  log_section "✅ All Security Gates Passed"
}

# ==============================================================================
# Deployment Confirmation
# ==============================================================================
confirm_deployment() {
  log_section "Deployment Confirmation"
  
  COMMIT_SHA=$(git rev-parse HEAD)
  COMMIT_MSG=$(git log -1 --pretty=%B)
  DEPLOY_TIME=$(date -u +"%Y-%m-%d %H:%M:%S UTC")
  
  echo "Environment:    $ENVIRONMENT"
  echo "Commit SHA:     $COMMIT_SHA"
  echo "Commit Message: $COMMIT_MSG"
  echo "Deploy Time:    $DEPLOY_TIME"
  echo "Deployed By:    $(whoami)"
  echo ""
  
  if [[ "$ENVIRONMENT" == "production" ]]; then
    log_warning "YOU ARE ABOUT TO DEPLOY TO PRODUCTION"
    log_warning "This will affect real users immediately"
    confirm_action "Are you absolutely sure?"
    confirm_action "Really sure? This is production."
  else
    confirm_action "Deploy to $ENVIRONMENT?"
  fi
}

# ==============================================================================
# Backup Current Deployment
# ==============================================================================
backup_deployment() {
  log_section "Creating Backup"
  
  BACKUP_DIR="$PROJECT_ROOT/backups/${ENVIRONMENT}_$(date +%Y%m%d_%H%M%S)"
  mkdir -p "$BACKUP_DIR"
  
  log_info "Backing up current deployment to $BACKUP_DIR..."
  
  # Backup would happen here
  # Example: kubectl get all -n kyiam-${ENVIRONMENT} -o yaml > "$BACKUP_DIR/k8s-backup.yaml"
  
  log_success "Backup created"
}

# ==============================================================================
# Deploy Application
# ==============================================================================
deploy_application() {
  log_section "Deploying Application"
  
  log_info "Deploying to $ENVIRONMENT..."
  
  case "$ENVIRONMENT" in
    staging)
      deploy_staging
      ;;
    production)
      deploy_production
      ;;
  esac
  
  log_success "Deployment complete"
}

