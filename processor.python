import base64
import json
import secrets
import time
from cryptography.hazmat.primitives.ciphers import Cipher, algorithms, modes
from cryptography.hazmat.backends import default_backend

# -------------------------------------------------------------------
# ENGINE 1: THE PCI-DSS COMPLIANT TOKENIZATION VAULT
# -------------------------------------------------------------------
class TokenizationVault:
    """
    Secures raw card data, issuing stateless tokens to merchants.
    Monetization: $0.02 - $0.05 per stored/verified vault token per month.
    """
    def __init__(self):
        # In production, this key must be managed by a Hardware Security Module (HSM)
        self.master_key = secrets.token_bytes(32)
        self.token_registry = {}

    def encrypt_card(self, card_number: str, cvv: str, expiry: str) -> str:
        # Create a unique initialization vector for AES-GCM encryption
        iv = secrets.token_bytes(12)
        encryptor = Cipher(
            algorithms.AES(self.master_key),
            modes.GCM(iv),
            backend=default_backend()
        ).encryptor()
        
        card_data = json.dumps({"pan": card_number, "cvv": cvv, "exp": expiry}).encode()
        ciphertext = encryptor.update(card_data) + encryptor.finalize()
        
        # Generate a unique token string to hand back to the merchant
        token = f"tok_live_{secrets.token_hex(16)}"
        
        # Package and store the encrypted payload securely
        self.token_registry[token] = {
            "iv": base64.b64encode(iv).decode(),
            "ciphertext": base64.b64encode(ciphertext).decode(),
            "tag": base64.b64encode(encryptor.tag).decode()
        }
        return token

# -------------------------------------------------------------------
# ENGINE 2: RESTFUL API GATEWAY & REVENUE SPLIT CALCULATOR
# -------------------------------------------------------------------
class FinancialAPIGateway:
    """
    The core infrastructure interface handling transaction processing and fees.
    Monetization: Compounding Transaction Fees (Non-Linear Take Rate)
    """
    def __init__(self, vault: TokenizationVault):
        self.vault = vault
        # Base fee structure charged to merchants (e.g., Stripe standard)
        self.merchant_rate_percent = 0.029
        self.merchant_flat_fee = 0.30
        
        # Actual underlying network/interchange cost to route the money
        self.network_cost_percent = 0.005  # Optimized internal routing cost
        self.network_flat_fee = 0.05

    def process_charge(self, merchant_id: str, token: str, amount_cents: int, instant_payout: bool = False) -> dict:
        """
        Processes payment, executes interchange arbitrage, and calculates revenue.
        Amounts calculated in cents to avoid floating-point errors.
        """
        if token not in self.vault.token_registry:
            return {"status": "failed", "error": "Invalid Token"}
            
        # 1. Total fee charged to the merchant
        total_merchant_fee = int(amount_cents * self.merchant_rate_percent) + int(self.merchant_flat_fee * 100)
        
        # 2. Revenue Stream 1: Core Transaction Take Rate (Interchange Arbitrage)
        actual_network_cost = int(amount_cents * self.network_cost_percent) + int(self.network_flat_fee * 100)
        base_processing_profit = total_merchant_fee - actual_network_cost
        
        # 3. Revenue Stream 2: Instant Payout Premium Fee
        payout_premium_revenue = 0
        if instant_payout:
            # Charge an extra 1.5% premium to clear funds immediately
            payout_premium_revenue = int(amount_cents * 0.015)
            total_merchant_fee += payout_premium_revenue
            
        # 4. Settle balances
        net_merchant_settlement = amount_cents - total_merchant_fee
        total_platform_revenue = base_processing_profit + payout_premium_revenue
        
        return {
            "status": "succeeded",
            "transaction_id": f"ch_{secrets.token_hex(12)}",
            "amount_processed": amount_cents,
            "merchant_received": net_merchant_settlement,
            "platform_gross_revenue": total_platform_revenue,
            "revenue_breakdown": {
                "arbitrage_take_rate": base_processing_profit,
                "instant_payout_premium": payout_premium_revenue
            }
        }

# -------------------------------------------------------------------
# ENGINE 3: THE AUTOMATED WEBHOOK NOTIFICATION SYSTEM
# -------------------------------------------------------------------
class WebhookEngine:
    """
    Dispatches asynchronous network events back to the merchant's servers.
    Monetization: Metered developer API usage beyond a baseline tier.
    """
    def __init__(self):
        self.delivery_log = []

    def dispatch_event(self, merchant_webhook_url: str, transaction_result: dict):
        # Create a cryptographically signed payload signature to prove it came from your platform
        payload = json.dumps(transaction_result, sort_keys=True)
        signature = hashlib.sha256(payload.encode()).hexdigest()
        
        event_packet = {
            "event": "payment.succeeded",
            "created": int(time.time()),
            "signature": signature,
            "data": transaction_result
        }
        
        # In production, this runs asynchronously using a task queue (like Celery/Redis)
        # to execute thousands of parallel HTTP POST requests instantly.
        self.delivery_log.append({"url": merchant_webhook_url, "delivered": True})
        return event_packet
