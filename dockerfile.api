# Use a highly secure, minimized Python footprint to reduce the attack surface
FROM python:3.11-slim AS base

WORKDIR /app

# Install system dependencies required for cryptography compilation
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libssl-dev \
    libffi-dev \
    && rm -rf /var/lib/apt/lists/*

# Manage Python dependencies securely
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Bring over the production codebase modules
COPY . .

# Run the API via an enterprise-grade ASGI/WSGI server (e.g., Gunicorn/Uvicorn)
EXPOSE 8080
CMD ["gunicorn", "-w", "4", "-b", "0.0.0.0:8080", "main:app"]
