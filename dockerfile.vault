FROM python:3.11-slim

WORKDIR /vault

RUN apt-get update && apt-get install -y --no-install-recommends \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY ./vault_module.py .

# Lock down execution privileges to a non-root system user for security compliance
RUN useradd -u 10001 vaultuser
USER vaultuser

EXPOSE 8443
CMD ["python", "vault_module.py"]
