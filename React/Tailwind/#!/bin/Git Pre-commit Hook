#!/bin/bash

################################################################################
# KYIAM Pre-Commit Hook
# Verifies all files have proper copyright headers before commit
################################################################################
#
# Copyright © 2026 KYIAM.xyz - All Rights Reserved
# EXPLICITLY ALL RIGHTS RESERVED - KYIAM.XYZ AI-to-AI © 2026
################################################################################

# Check for copyright header in staged files
MISSING_HEADERS=()

for file in $(git diff --cached --name-only); do
    if [ -f "$file" ]; then
        if ! grep -q "KYIAM.XYZ AI-to-AI © 2026" "$file"; then
            MISSING_HEADERS+=("$file")
        fi
    fi
done

if [ ${#MISSING_HEADERS[@]} -ne 0 ]; then
    echo "ERROR: The following files are missing copyright headers:"
    printf '%s\n' "${MISSING_HEADERS[@]}"
    echo ""
    echo "Please add the appropriate header using the templates in docs/headers.md"
    echo "Or run: ./scripts/add-headers.sh"
    exit 1
fi

echo "✓ All files have proper copyright headers"

################################################################################
# END OF SCRIPT
# EXPLICITLY ALL RIGHTS RESERVED - KYIAM.XYZ AI-to-AI © 2026
################################################################################
